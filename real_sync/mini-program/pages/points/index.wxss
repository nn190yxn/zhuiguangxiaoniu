.hero{padding:26px 20px;border-radius:22px;background:linear-gradient(145deg,#ff6b35,#ff9a62);color:#fff;text-align:center;box-shadow:0 12px 28px rgba(255,107,53,.24)}.eyebrow,.balance,.balance-label,.streak{display:block}.eyebrow{font-size:12px;letter-spacing:4px;opacity:.85}.balance{margin-top:5px;font-size:44px;line-height:1.2;font-weight:800}.balance-label,.streak{font-size:12px;opacity:.9}.checkin-btn{width:150px;margin:15px auto 8px;border:0;border-radius:22px;background:#fff;color:#e95520;font-size:14px;font-weight:700}.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0 12px}.tab{padding:10px;border-radius:12px;background:#fff;text-align:center;color:#6b625c}.tab.active{background:#1f1a17;color:#fff;font-weight:700}.state-card,.my-rank{padding:28px 16px;border-radius:16px;background:#fff;text-align:center;color:#6b625c}.state-card button,.write-state button{margin-top:10px}.state-card.error,.write-state{color:#a33b1d;background:#fff1ea}.metric-row,.rule,.rank-row,.gift-meta{display:flex;align-items:center;justify-content:space-between}.metric-row{padding-bottom:14px;border-bottom:1px solid #eee6df}.metric-row strong{font-size:24px;color:#ff6b35}.rule{padding:12px 0;border-bottom:1px solid #f2ece7}.accent{color:#ff6b35;font-weight:700}.my-rank{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:10px}.my-rank strong{font-size:24px;color:#ff6b35}.rank-row{padding:14px 16px;margin-bottom:8px;border-radius:14px;background:#fff}.rank-no{width:34px;color:#ff6b35;font-weight:800}.rank-name{flex:1}.mall-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.gift-card{padding:12px;border-radius:16px;background:#fff}.gift-card image{width:100%;height:110px;border-radius:10px;background:#f1ece7}.gift-title{margin:9px 0 5px;font-weight:700}.gift-meta{font-size:11px;color:#6b625c}.gift-card button{margin-top:10px;background:#ff6b35;color:#fff}.write-state{position:sticky;bottom:12px;z-index:4;padding:12px;border-radius:14px;text-align:center}.modal-mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;padding:16px;background:rgba(0,0,0,.48);box-sizing:border-box}.exchange-modal{width:100%;padding:20px;border-radius:20px;background:#fff;box-sizing:border-box}.modal-title{margin-bottom:14px;font-size:18px;font-weight:800}.exchange-modal input,.exchange-modal textarea{width:100%;margin-bottom:10px;padding:11px;border:1px solid #e5ddd6;border-radius:10px;box-sizing:border-box;background:#faf8f6}.exchange-modal textarea{height:80px}.modal-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.modal-actions .primary{background:#ff6b35;color:#fff}

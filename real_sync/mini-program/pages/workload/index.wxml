<view class="container">
  <view class="hero">
    <view class="hero-title">今日工作量</view>
    <view class="hero-sub">每天从工作量指标中自选 4 项完成并提交</view>
    <view class="identity-card">
      <view class="identity-item"><text class="identity-label">姓名</text><text class="identity-value">{{context.name || '员工'}}</text></view>
      <view class="identity-item"><text class="identity-label">门店</text><text class="identity-value">{{context.store_name || '未绑定门店'}}</text></view>
      <view class="identity-item"><text class="identity-label">岗位</text><text class="identity-value">{{context.role_name || context.role || '未绑定岗位'}}</text></view>
    </view>
  </view>

  <view class="card state-panel">
    <view class="state-line"><text class="state-pill {{reportStatusClass}}">{{reportStatusLabel}}</text><text class="deadline">{{deadlineText}}</text></view>
    <view class="state-line"><text class="progress-copy">{{conversionSummary && submitStatus === 'submitted' ? '已生效 ' + conversionSummary.effective_points + '/' + conversionSummary.required_points + ' 点' : '已完成 ' + positiveCount + '/' + minimumPositiveCount + ' 项'}}</text><text class="deadline">{{isDirty ? '尚未保存' : lastSavedText}}</text></view>
    <view class="progress-track"><view class="progress-bar" style="width:{{progressPercent}}%"></view></view>
    <view class="status">{{conversionSummary && submitStatus === 'submitted' ? '距离达标 ' + conversionSummary.gap_points + ' 点，待审核 ' + conversionSummary.pending_points + ' 点' : '待填 ' + pendingCount + ' 项，待补凭证 ' + evidenceGapCount + ' 项'}}</view>
  </view>

  <view wx:if="{{conversionSummary && submitStatus === 'submitted'}}" class="card conversion-panel">
    <view class="conversion-title">工作量换算结果</view>
    <view class="conversion-grid">
      <view><text class="conversion-value">{{conversionSummary.effective_points}}</text><text class="conversion-label">有效点数</text></view>
      <view><text class="conversion-value">{{conversionSummary.pending_points}}</text><text class="conversion-label">待审核</text></view>
      <view><text class="conversion-value">{{conversionSummary.gap_points}}</text><text class="conversion-label">距离达标</text></view>
    </view>
  </view>

  <view class="card">
    <view wx:if="{{messageEntryText}}" class="draft-tip">{{messageEntryText}}</view>
    <view wx:if="{{messageEntryWarning}}" class="status err">{{messageEntryWarning}}</view>
    <view class="form-row">
      <view class="field">
        <text class="label">日期</text>
        <picker mode="date" value="{{reportDate}}" end="{{maxDate}}" bindchange="onDateChange">
          <view class="picker-value">{{reportDate}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">岗位</text>
        <picker range="{{roleOptions}}" range-key="label" value="{{roleIndex}}" bindchange="onRoleChange" disabled="{{roleLocked}}">
          <view class="picker-value">{{currentRoleLabel}}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <text class="label">门店</text>
      <view class="picker-value readonly">{{context.store_name || ('门店 ID ' + storeId) || '未绑定门店'}}</view>
    </view>
    <view class="status {{statusType}}">{{statusText}}</view>
  </view>

  <view class="card">
    <view wx:if="{{templateDescription}}" class="draft-tip">{{templateDescription}}</view>
    <view wx:if="{{draftEvidenceTip}}" class="draft-tip">{{draftEvidenceTip}}</view>
    <block wx:if="{{items.length}}">
      <view class="metric {{item.has_error ? 'has-error' : ''}}" id="metric_{{item.metric_code}}" wx:for="{{items}}" wx:key="metric_code">
        <view class="metric-main">
          <view class="metric-info">
            <view class="metric-name">{{item.metric_name}}</view>
            <view class="metric-meta">{{item.category_label}} · {{item.unit}}</view>
          </view>
          <input class="metric-input" type="digit" data-code="{{item.metric_code}}" value="{{item.current_value}}" bindinput="onMetricInput" bindblur="onMetricInput" disabled="{{busyAction || !isWritable || isWeeklyRestDay || submitStatus==='submitted' || !item.editable}}" />
        </view>
        <view wx:if="{{item.aggregate_tip}}" class="draft-tip">{{item.aggregate_tip}}</view>
        <view wx:if="{{item.field_error}}" class="metric-error">{{item.field_error}}</view>
        <view wx:if="{{item.need_evidence}}" class="evidence-box">
          <view class="evidence-head">
            <view>
              <view class="evidence-title">图片凭证</view>
              <view class="metric-meta">已上传 {{item.evidence_count}} / 最多 {{item.max_evidence_count || 10}} 张</view>
            </view>
            <view class="metric-meta">需上传凭证 {{item.min_evidence_count || 1}}-{{item.max_evidence_count || 10}} 张</view>
          </view>
          <view class="evidence-tip">{{currentReportId ? '保存后可继续补传，审核侧会读取这里的图片' : '请先保存草稿，再上传对应图片'}}</view>
          <view class="evidence-actions">
            <button class="evidence-btn" data-code="{{item.metric_code}}" bindtap="chooseEvidence" loading="{{uploadingMetricCode===item.metric_code}}" disabled="{{busyAction || !isWritable || submitStatus==='submitted'}}">上传图片</button>
            <button wx:if="{{uploadFailedMetricCode===item.metric_code}}" class="retry-btn" data-code="{{item.metric_code}}" bindtap="retryEvidence" disabled="{{busyAction}}">重试上传</button>
          </view>
          <view wx:if="{{uploadingMetricCode===item.metric_code}}" class="upload-progress"><view style="width:{{uploadProgress}}%"></view></view>
          <view wx:if="{{item.has_evidence}}" class="evidence-list">
            <block wx:for="{{item.evidence_list}}" wx:for-item="file" wx:key="id">
              <view class="evidence-item">
                <image class="evidence-image" src="{{file.file_url}}" mode="aspectFill"></image>
                <view class="evidence-name">{{file.file_name || '已上传凭证'}}</view>
                <view class="evidence-card-actions">
                  <button class="evidence-mini-btn" data-url="{{file.file_url}}" bindtap="previewEvidence">查看</button>
                  <button class="evidence-mini-btn danger" data-id="{{file.id}}" data-code="{{item.metric_code}}" bindtap="deleteEvidence" disabled="{{busyAction || !isWritable || submitStatus==='submitted'}}">删除</button>
                </view>
              </view>
            </block>
          </view>
          <view wx:else class="evidence-empty">暂未上传凭证图片</view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">{{statusText || '暂无可填写模板'}}</view>
  </view>

  <view class="card">
    <text class="label">备注</text>
    <textarea class="textarea" value="{{remarks}}" bindinput="onRemarksInput" disabled="{{busyAction || !isWritable || isWeeklyRestDay || submitStatus==='submitted'}}" placeholder="填写今日特殊情况" />
  </view>

  <view class="actions">
    <view wx:if="{{busyAction}}" class="busy-note">{{busyAction==='submitting' ? '正在提交...' : busyAction==='uploading' ? '正在上传...' : '正在保存...'}}</view>
    <button class="btn secondary" bindtap="saveDraft" disabled="{{busyAction || !isWritable || isWeeklyRestDay || submitStatus==='submitted'}}">保存草稿</button>
    <button class="btn primary" bindtap="submitReport" disabled="{{busyAction || !isWritable || isWeeklyRestDay || submitStatus==='submitted'}}">提交日报</button>
  </view>

  <view wx:if="{{showPrivacyModal}}" class="privacy-mask" bindtap="handleRejectPrivacyAuthorization">
    <view class="privacy-modal" catchtap="">
      <view class="privacy-modal-title">隐私授权提示</view>
      <view class="privacy-modal-body">
        上传凭证图片需要获取您的授权。请阅读并同意<text class="privacy-link" bindtap="handleOpenPrivacyContract">{{privacyContractName}}</text>
      </view>
      <view class="privacy-modal-actions">
        <button class="privacy-btn cancel" bindtap="handleRejectPrivacyAuthorization">暂不同意</button>
        <button class="privacy-btn confirm" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">同意并继续</button>
      </view>
    </view>
  </view>
</view>

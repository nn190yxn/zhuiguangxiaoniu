<view class="container"><view class="hero"><view><text class="eyebrow">MONTHLY SIGNALS</text><text class="title">数据中心</text><text class="subtitle">查看训练、考核和工作量的本月状态。</text><text class="updated-at">更新于 {{updatedAt || '刚刚'}}</text></view><picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange"><view class="month">{{month}} ↕</view></picker></view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button size="mini" bindtap="load">重新加载</button></view><view wx:if="{{personal}}" class="metric-grid"><view class="metric-card" bindtap="goDrill"><text class="metric-label">演练完成</text><text class="metric-value">{{personal.drill.completed}}</text><text class="metric-note">共 {{personal.drill.total}} 次</text></view><view class="metric-card" bindtap="goExam"><text class="metric-label">考核通过</text><text class="metric-value">{{personal.exam.passed}}</text><text class="metric-note">平均 {{personal.exam.average_score || '-'}} 分</text></view><view class="metric-card metric-wide" bindtap="goWorkload"><text class="metric-label">工作量日报</text><text class="metric-value">{{personal.workload.submitted}}</text><text class="metric-note">已提交 {{personal.workload.reports}} 份</text></view></view><view wx:if="{{manager}}" class="manager-card" bindtap="goManager"><view><text class="manager-title">店长团队数据</text><text class="manager-note">查看授权门店工作量汇总与员工明细</text></view><text class="arrow">›</text></view><view class="menu-section"><view class="menu-item" bindtap="goMine"><text>进入我的</text><text class="arrow">›</text></view></view><view wx:if="{{loading}}" class="empty">正在加载本月数据...</view></view>

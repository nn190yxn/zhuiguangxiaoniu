.hero { display: flex; justify-content: space-between; align-items: flex-end; padding: 8px 0 22px; }.eyebrow { display: block; color: #ff6b35; font-size: 10px; letter-spacing: 2px; }.title { display: block; margin-top: 4px; font-size: 28px; font-weight: 700; }.subtitle { display: block; margin-top: 4px; color: #6b625c; font-size: 13px; }.month { padding: 7px 10px; color: #ff6b35; background: #fff; border-radius: 12px; font-size: 12px; }.metric-grid { display: flex; flex-wrap: wrap; gap: 10px; }.metric-card { width: calc(50% - 5px); min-height: 124px; padding: 16px; box-sizing: border-box; background: #fff; border-radius: 16px; }.metric-wide { width: 100%; min-height: 108px; background: #fff8f2; }.metric-label, .metric-value, .metric-note { display: block; }.metric-label { color: #6b625c; font-size: 12px; }.metric-value { margin-top: 10px; color: #1f1a17; font-size: 30px; font-weight: 700; }.metric-note { color: #9a958e; font-size: 11px; }.manager-card, .menu-section { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 16px; background: #1f1a17; border-radius: 16px; color: #fff; }.manager-title, .manager-note { display: block; }.manager-title { font-size: 16px; font-weight: 700; }.manager-note { margin-top: 4px; color: #d5c9c0; font-size: 12px; }.menu-section { display: block; background: #fff; color: #1f1a17; }.menu-item { display: flex; justify-content: space-between; padding: 3px 0; font-size: 14px; }.arrow { color: #ff6b35; font-size: 22px; }.error-box { margin-bottom: 12px; padding: 12px; color: #a94442; background: #fff1f0; border-radius: 12px; }.empty { padding: 24px 0; color: #9a958e; text-align: center; }

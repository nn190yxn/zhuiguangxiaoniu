<view class="container">
  <view class="entry-grid">
    <view wx:for="{{entries}}" wx:key="key" class="entry-card {{item.cls}}" bindtap="goToEntry" data-key="{{item.key}}">
      <view class="entry-title">{{item.title}}</view>
      <view class="entry-desc">{{item.desc}}</view>
    </view>
  </view>

  <view wx:if="{{showStagePanel}}" class="stage-panel">
    <view class="stage-panel-title">选择专项环节</view>
    <view class="stage-grid">
      <view wx:for="{{stageEntries}}" wx:key="stage_code" class="stage-cell" bindtap="goToStagePractice" data-code="{{item.stage_code}}">
        <view class="stage-cell-name">{{item.name}}</view>
        <view class="stage-cell-goal">{{item.core_goal}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{stageEntries.length === 0}}">暂无可用的专项环节</view>
  </view>

  <view class="filter-tabs">
    <view class="filter-tab {{currentStatus === '' ? 'active' : ''}}" bindtap="selectFilter" data-status="">全部</view>
    <view class="filter-tab {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="selectFilter" data-status="pending">待开始</view>
    <view class="filter-tab {{currentStatus === 'learning' ? 'active' : ''}}" bindtap="selectFilter" data-status="learning">进行中</view>
    <view class="filter-tab {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="selectFilter" data-status="completed">已完成</view>
  </view>

  <view class="empty" wx:if="{{minimumVersionMessage}}">{{minimumVersionMessage}}</view>

  <view class="drill-list">
    <view class="drill-card {{item.status_class}}" wx:for="{{list}}" wx:key="id" bindtap="goToDrill" data-id="{{item.id}}" data-plan-item-id="{{item.plan_item_id}}">
      <view class="drill-header">
        <view class="drill-title">{{item.title}}</view>
        <view class="drill-status {{item.status_class}}">
          {{item.status_text}}
        </view>
      </view>
      <view class="drill-desc">{{item.description}}</view>
      <view class="drill-progress">
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{item.progress || 0}}%"></view>
        </view>
      </view>
      <view class="drill-meta">
        <text>{{item.knowledge_card_title || '知识卡学习'}}</text>
        <text>{{item.progress || 0}}%</text>
      </view>
      <view class="drill-steps">
        <text class="step-badge {{step.class_name}}" wx:for="{{item.step_badges}}" wx:for-item="step" wx:key="step">
          {{step.label}}
        </text>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0 && !loading}}">
      <text>暂无演练任务</text>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>

<view class="container">
  <view wx:if="{{loading}}" class="loading">{{loadingMessage}}</view>
  <view wx:elif="{{feedbackState.status === 'error' || feedbackState.status === 'offline' || feedbackState.status === 'conflict'}}" class="empty"><text>{{feedbackState.message}}</text><button size="mini" bindtap="retryFeedback">重新加载</button></view>

  <view wx:if="{{!loading && feedback}}" class="feedback-content">
    <view class="score-card">
      <view class="score-main">
        <view class="score-number" style="color:{{getScoreColor(feedback.total_score)}}">
          {{feedback.total_score}}
        </view>
        <view class="score-label">总分</view>
      </view>
      <view class="level-badge level-{{feedback.level}}">
        {{getLevelName(feedback.level)}}
      </view>
    </view>

    <view class="section">
      <view class="section-title">录音信息</view>
      <view class="info-row">
        <text class="info-label">场景：</text>
        <text class="info-value">{{feedback.scene || '演练'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">时长：</text>
        <text class="info-value">{{formatDuration(feedback.audio_duration)}}</text>
      </view>
      <button wx:if="{{feedback.audio_playable}}" class="play-btn" bindtap="playAudio" data-url="{{feedback.audio_url}}" data-file-id="{{feedback.audio_url_media.fileID}}" data-asset-key="{{feedback.audio_url_media.asset_key}}" data-status="{{feedback.audio_url_media.status}}">
        [播放] 播放录音
      </button>
    </view>

    <view class="section">
      <view class="section-title">转录文本</view>
      <view class="transcript">
        {{feedback.transcribed_text || '暂无转录内容'}}
      </view>
    </view>

    <view class="section" wx:if="{{feedback.dimension_list.length > 0}}">
      <view class="section-title">成交能力评分</view>
      <view class="dimension-list">
        <view wx:for="{{feedback.dimension_list}}" wx:key="code" class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">{{item.name}}</text>
            <text class="dimension-score" style="color:{{getScoreColor(item.score)}}">
              {{item.score}}分
            </text>
          </view>
          <view class="dimension-bar">
            <view class="dimension-fill" style="width:{{item.score}}%;background:{{getScoreColor(item.score)}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{weakestDimension}}">
      <view class="section-title">下一步训练建议</view>
      <view class="weak-cta">
        <view class="weak-cta-text">最薄弱项：{{weakestDimension.name}}（{{weakestDimension.score}}分）</view>
        <button class="weak-cta-btn" bindtap="practiceWeakStage">去练「{{weakestDimension.stage_name}}」专项</button>
      </view>
    </view>

    <view class="section" wx:if="{{stageJourney.length > 1}}">
      <view class="section-title">流程环节完成情况</view>
      <view class="journey-bar">
        <view wx:for="{{stageJourney}}" wx:key="stage_code"
          class="journey-chip {{item.status === 'completed' ? 'done' : item.status === 'active' ? 'active' : 'pending'}}">
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{feedback.strengths.length > 0 || feedback.deal_risk || feedback.replacement_scripts.length > 0 || feedback.smart_actions.length > 0}}">
      <view class="section-title">销冠教练点评</view>
      <view wx:if="{{feedback.strengths.length > 0}}" class="coach-block">
        <view class="coach-label">亮点</view>
        <view wx:for="{{feedback.strengths}}" wx:key="index" class="coach-line">✓ {{item}}</view>
      </view>
      <view wx:if="{{feedback.deal_risk}}" class="coach-block">
        <view class="coach-label">最可能丢单的位置</view>
        <view class="coach-line coach-risk">{{feedback.deal_risk}}</view>
      </view>
      <view wx:if="{{feedback.replacement_scripts.length > 0}}" class="coach-block">
        <view class="coach-label">替换话术</view>
        <view wx:for="{{feedback.replacement_scripts}}" wx:key="index" class="coach-line coach-script">{{item}}</view>
      </view>
      <view wx:if="{{feedback.smart_actions.length > 0}}" class="coach-block">
        <view class="coach-label">训练任务</view>
        <view wx:for="{{feedback.smart_actions}}" wx:key="index" class="coach-line">{{item}}</view>
      </view>
    </view>

    <view class="section" wx:if="{{masteryList.length > 0}}">
      <view class="section-title">我的掌握度</view>
      <view class="mastery-list">
        <view wx:for="{{masteryList}}" wx:key="name" class="mastery-item">
          <text class="mastery-name">{{item.name}}</text>
          <view class="mastery-bar"><view class="mastery-fill" style="width:{{item.score}}%"></view></view>
          <text class="mastery-score">{{item.score}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{feedback.stage_scores}}">
      <view class="section-title">环节反馈</view>
      <view class="stage-list">
        <view wx:for="{{feedback.stage_scores}}" wx:key="code" class="stage-item">
          <view class="stage-header">
            <text class="stage-name">{{item.name}}</text>
            <text class="stage-score" style="color:{{getScoreColor(item.score)}}">
              {{item.score}}分
            </text>
          </view>
          <view class="stage-bar">
            <view class="stage-fill" style="width:{{item.score}}%;background:{{getScoreColor(item.score)}}"></view>
          </view>
          <view class="stage-feedback">{{item.feedback}}</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">AI反馈</view>
      <view class="feedback-text">
        {{feedback.feedback}}
      </view>
    </view>

    <view class="section" wx:if="{{feedback.suggestions && feedback.suggestions.length > 0}}">
      <view class="section-title">改进建议</view>
      <view class="suggestion-list">
        <view wx:for="{{feedback.suggestions}}" wx:key="index" class="suggestion-item">
          {{index + 1}}. {{item}}
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">标准话术参考</view>
      <view class="script-reference">
        {{feedback.script_content}}
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && feedbackList}}" class="feedback-list">
    <view wx:for="{{feedbackList}}" wx:key="id" class="feedback-card" bindtap="viewFeedback" data-id="{{item.id}}">
      <view class="feedback-header">
        <text class="feedback-scene">{{item.scene || '演练'}}</text>
        <text class="feedback-score" style="color:{{getScoreColor(item.total_score)}}">{{item.total_score}}分</text>
      </view>
      <view class="feedback-meta">
        <text>{{getLevelName(item.level)}}</text>
        <text>{{formatDuration(item.audio_duration)}}</text>
        <text>{{item.created_at}}</text>
      </view>
      <button wx:if="{{item.audio_playable}}" class="mini-play-btn" catchtap="playAudio" data-url="{{item.audio_url}}" data-file-id="{{item.audio_url_media.fileID}}" data-asset-key="{{item.audio_url_media.asset_key}}" data-status="{{item.audio_url_media.status}}">
        [播放]
      </button>
    </view>
  </view>

  <view wx:if="{{!loading && !feedback && !feedbackList}}" class="empty">
    暂无反馈记录
  </view>
</view>

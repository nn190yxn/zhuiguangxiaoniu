.free-chat-page {
  padding: 16px;
  padding-bottom: 120px;
}

.start-card,
.chat-header,
.summary-card,
.input-panel {
  background: #ffffff;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
}

.page-title,
.chat-title {
  font-size: 20px;
  font-weight: 700;
  color: #1f1a17;
  margin-bottom: 8px;
}

.page-desc,
.scenario-desc,
.chat-progress {
  font-size: 13px;
  color: #6b625c;
  line-height: 1.6;
}

.stage-context {
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #fff3e0;
}

.stage-name {
  font-size: 14px;
  font-weight: 600;
  color: #ff6b35;
}

.stage-desc {
  margin-top: 4px;
  font-size: 12px;
  color: #6b625c;
}

.field-label {
  margin: 20px 0 8px;
  font-size: 14px;
  font-weight: 600;
  color: #1f1a17;
}

.scenario-picker {
  border: 1px solid #f0e5dd;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 20px;
  background: #fffaf6;
}

.scenario-name {
  font-size: 16px;
  font-weight: 600;
  color: #ff6b35;
  margin-bottom: 4px;
}

.persona-panel {
  border: 1px solid #f0e5dd;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 16px;
  background: #fffdf9;
}

.persona-input {
  min-height: 40px;
  box-sizing: border-box;
  border-bottom: 1px solid #f0e5dd;
  font-size: 13px;
  color: #1f1a17;
}

.persona-field { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; }
.persona-label { color: #5b6472; font-size: 26rpx; }
.persona-picker { min-width: 240rpx; padding: 16rpx 20rpx; border: 1rpx solid #dfe3e8; border-radius: 12rpx; background: #fff; color: #1f2937; text-align: right; }

.random-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  font-size: 13px;
  color: #1f1a17;
}

.btn-primary,
.send-btn,
.end-btn {
  background: #ff6b35;
  color: #ffffff;
  border-radius: 24px;
  font-size: 15px;
}

.message-list {
  margin-bottom: 16px;
}

.message {
  margin-bottom: 12px;
  padding: 12px;
  border-radius: 14px;
  background: #ffffff;
}

.message.user {
  margin-left: 28px;
  background: #fff3e0;
}

.message.assistant {
  margin-right: 28px;
  background: #f5f3f0;
}

.message.system {
  background: #eef7ff;
}

.message-role {
  font-size: 12px;
  font-weight: 600;
  color: #ff6b35;
  margin-bottom: 6px;
}

.message-content {
  font-size: 14px;
  line-height: 1.7;
  color: #1f1a17;
  white-space: pre-wrap;
}

.summary-title {
  font-size: 16px;
  font-weight: 700;
  color: #1f1a17;
  margin-bottom: 8px;
}

.coaching-card {
  background: #fffdf2;
  border: 1px solid #f2dfad;
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 16px;
}

.coaching-line,
.coaching-risk {
  font-size: 13px;
  line-height: 1.7;
  color: #5f5144;
}

.coaching-risk {
  color: #b33a2b;
}

.chat-input {
  width: 100%;
  min-height: 96px;
  box-sizing: border-box;
  border: 1px solid #e8dfd8;
  border-radius: 12px;
  padding: 12px;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 12px;
}

.input-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.voice-status {
  margin-top: 8px;
  color: #6b625c;
  font-size: 12px;
  text-align: center;
}

.voice-btn,
.send-btn,
.end-btn {
  flex: 1;
  min-width: 96px;
  border-radius: 22px;
  font-size: 14px;
}

.voice-btn {
  background: #1f1a17;
  color: #ffffff;
}

.voice-btn.recording {
  background: #d64545;
}

.voice-overlay {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 96px;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.voice-sheet {
  width: 170px;
  min-height: 170px;
  box-sizing: border-box;
  padding: 18px 16px 14px;
  border-radius: 14px;
  background: rgba(31, 26, 23, 0.94);
  color: #fff;
  text-align: center;
}

.voice-mic {
  width: 48px;
  height: 48px;
  margin: 0 auto 8px;
  border-radius: 50%;
  background: #d64545;
  line-height: 48px;
  font-size: 14px;
}

.voice-mic-cancel {
  background: #6b625c;
}

.voice-overlay-title {
  font-size: 14px;
  font-weight: 600;
}

.voice-duration {
  margin-top: 4px;
  color: #d8cec7;
  font-size: 12px;
}

.voice-bars {
  display: flex;
  height: 26px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin-top: 8px;
}

.voice-bar {
  width: 4px;
  height: 10px;
  border-radius: 3px;
  background: #ff6b35;
  animation: voice-wave 0.8s ease-in-out infinite alternate;
}

.voice-bar-1 { animation-delay: 0.1s; }
.voice-bar-2 { animation-delay: 0.2s; }
.voice-bar-3 { animation-delay: 0.3s; }
.voice-bar-4 { animation-delay: 0.15s; }

@keyframes voice-wave {
  from { height: 8px; }
  to { height: 25px; }
}

.voice-cancel-hint {
  margin-top: 8px;
  color: #d8cec7;
  font-size: 11px;
}

.end-btn {
  background: #4b5f8f;
}

/* ---- 流程对练：阶段进度条与目标卡 ---- */
.stage-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 8px 16px 2px;
}

.stage-chip {
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 999px;
  background: #f0eeeb;
  color: #b3aca4;
}

.stage-chip.done {
  background: #e8f5e9;
  color: #43a047;
}

.stage-chip.active {
  background: #fff3e0;
  color: #ff6b35;
  font-weight: 600;
}

.stage-goal-card {
  margin: 8px 16px;
  padding: 10px 14px;
  background: #faf9f7;
  border-left: 4px solid #ff6b35;
  border-radius: 10px;
}

.stage-goal-title {
  font-size: 13px;
  font-weight: 700;
  color: #1f1a17;
  margin-bottom: 4px;
}

.stage-goal-text {
  font-size: 12px;
  color: #6b625c;
  line-height: 1.6;
}

.stage-actions {
  margin-top: 6px;
}

.stage-action {
  font-size: 12px;
  color: #9a958e;
  line-height: 1.9;
}

.stage-action.checked {
  color: #43a047;
}

.flow-advance-entry {
  font-size: 12px;
  color: #ff6b35;
  padding: 2px 8px;
  border: 1px solid #ff6b35;
  border-radius: 999px;
}

/* ---- 推进建议卡 ---- */
.advance-card {
  margin: 10px 16px;
  padding: 12px 14px;
  background: #fff8e1;
  border: 1px solid #ffd54f;
  border-radius: 12px;
}

.advance-title {
  font-size: 13px;
  font-weight: 700;
  color: #b26a00;
  margin-bottom: 4px;
}

.advance-reason {
  font-size: 12px;
  color: #6b625c;
  line-height: 1.6;
}

.advance-next {
  font-size: 12px;
  color: #1f1a17;
  margin-top: 4px;
  line-height: 1.6;
}

.advance-actions {
  display: flex;
  gap: 10px;
  margin-top: 8px;
}

.advance-confirm {
  flex: 1;
  background: #ff6b35;
  color: #fff;
  font-size: 13px;
  border-radius: 999px;
  line-height: 2;
  padding: 0;
}

.advance-dismiss {
  flex: 1;
  background: #fff;
  color: #6b625c;
  font-size: 13px;
  border-radius: 999px;
  line-height: 2;
  padding: 0;
  border: 1px solid #e0dbd4;
}

/* ---- 阶段切换系统消息 ---- */
.message.stage-transition {
  align-self: stretch;
  text-align: center;
}

.message.stage-transition .message-content {
  background: #e8f0fe;
  color: #1a73e8;
  border-radius: 12px;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 600;
}

/* ---- 重试行 ---- */
.retry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6px 0;
}

.retry-hint {
  font-size: 12px;
  color: #d84315;
}

.retry-btn {
  background: #fff3e0;
  color: #d84315;
  font-size: 12px;
  border-radius: 999px;
}

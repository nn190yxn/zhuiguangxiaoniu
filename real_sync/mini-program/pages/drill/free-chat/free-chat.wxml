<view class="container free-chat-page">
  <view wx:if="{{!started}}" class="start-card">
    <view class="page-title">{{mode === 'qa' ? '销售 Q&A' : mode === 'flow' ? '完整流程对练' : mode === 'stage' ? '专项对练' : '自由演练'}}</view>
    <view class="page-desc">AI 扮演家长连续提问，你可以输入或长按语音回答，系统会逐轮给出点评并在结束后汇总评分。</view>
    <view class="field-label">选择演练场景</view>
    <picker mode="selector" range="{{scenarios}}" range-key="name" value="{{scenarioIndex}}" bindchange="onScenarioChange">
      <view class="scenario-picker">
        <view class="scenario-name">{{selectedScenario.name}}</view>
        <view class="scenario-desc">{{selectedScenario.description}}</view>
      </view>
    </picker>
    <view wx:if="{{mode === 'stage' && currentStage}}" class="stage-goal-card">
      <view class="stage-goal-title">专项环节：{{currentStage.name}}</view>
      <view class="stage-goal-text">{{currentStage.core_goal}}</view>
    </view>
    <view class="persona-panel" wx:if="{{mode !== 'stage'}}">
      <view class="field-label">家长画像</view>
      <view wx:for="{{personaFields}}" wx:key="key" class="persona-field">
        <text class="persona-label">{{item.label}}</text>
        <picker mode="selector" range="{{item.options}}" range-key="name" value="{{item.selectedIndex}}" data-index="{{index}}" bindchange="onPersonaFilterChange">
          <view class="persona-picker">{{item.selectedName}}</view>
        </picker>
      </view>
      <view class="random-row">
        <text>随机画像与随机追问</text>
        <switch checked="{{randomMode}}" bindchange="toggleRandomMode" />
      </view>
    </view>
    <button class="btn-primary" loading="{{loading}}" bindtap="startChat">{{mode === 'qa' ? '开始 Q&A' : mode === 'flow' ? '开始完整流程' : mode === 'stage' ? '开始专项对练' : '开始自由演练'}}</button>
  </view>

  <view wx:if="{{started}}" class="chat-area">
    <view class="chat-header">
      <view class="chat-title">{{modeName}}中</view>
      <view wx:if="{{mode === 'flow'}}" class="flow-advance-entry" bindtap="manualAdvance">进入下一环节 ›</view>
    </view>

    <view wx:if="{{stageProgress.length > 1}}" class="stage-bar">
      <view wx:for="{{stageProgress}}" wx:key="stage_code"
        class="stage-chip {{item.status === 'completed' ? 'done' : item.status === 'active' ? 'active' : 'pending'}}">
        {{item.label}}
      </view>
    </view>

    <view wx:if="{{currentStage}}" class="stage-goal-card">
      <view class="stage-goal-title">本环节目标：{{currentStage.name}}</view>
      <view class="stage-goal-text">{{currentStage.core_goal}}</view>
      <view wx:if="{{currentStage.validation_actions.length}}" class="stage-actions">
        <view wx:for="{{currentStage.validation_actions}}" wx:key="*this"
          class="stage-action {{coveredActions.indexOf(item) > -1 ? 'checked' : ''}}">
          {{coveredActions.indexOf(item) > -1 ? '✓' : '○'}} {{item}}
        </view>
      </view>
    </view>

    <view class="message-list">
      <view wx:for="{{messages}}" wx:key="index" class="message {{item.role === 'stage-transition' ? 'stage-transition' : item.role}}">
        <view class="message-role">{{item.label}}</view>
        <view class="message-content">{{item.content}}</view>
      </view>
    </view>

    <view wx:if="{{advanceSuggestion}}" class="advance-card">
      <view class="advance-title">💡 建议进入下一环节</view>
      <view class="advance-reason">{{advanceSuggestion.reason}}</view>
      <view wx:if="{{advanceSuggestion.next_stage}}" class="advance-next">下一环节：{{advanceSuggestion.next_stage.name}} —— {{advanceSuggestion.next_stage.core_goal}}</view>
      <view class="advance-actions">
        <button class="advance-confirm" bindtap="confirmAdvance" disabled="{{loading}}">进入下一环节</button>
        <button class="advance-dismiss" bindtap="dismissAdvance" disabled="{{loading}}">再练练</button>
      </view>
    </view>

    <view wx:if="{{summary}}" class="summary-card">
      <view class="summary-title">演练总结</view>
      <view>综合得分：{{summary.avg_score}} 分</view>
      <view>等级：{{summary.level_name}}</view>
      <view>完成轮次：{{summary.total_responses}}</view>
    </view>

    <view wx:if="{{replyCoaching}}" class="coaching-card">
      <view class="summary-title">本轮回复建议</view>
      <view wx:if="{{replyMissingText}}" class="coaching-line">待补齐：{{replyMissingText}}</view>
      <view wx:for="{{replyCoaching.risks}}" wx:key="type" class="coaching-risk">风险：{{item.matched}}，建议：{{item.replacement}}</view>
      <view wx:for="{{replyCoaching.suggestions}}" wx:key="index" class="coaching-line">{{item}}</view>
    </view>

    <view wx:if="{{!ended}}" class="input-panel">
      <textarea class="chat-input" placeholder="输入你的回答，或点击语音按钮录入" value="{{inputText}}" bindinput="onInput"></textarea>
      <view wx:if="{{pendingRetryContent}}" class="retry-row">
        <text class="retry-hint">AI 家长刚才没有回应，你的回答已保留</text>
        <button class="retry-btn" size="mini" bindtap="retryPendingTurn" disabled="{{loading}}">重试发送</button>
      </view>
      <view class="input-actions">
        <button class="voice-btn {{isRecording ? 'recording' : ''}}" bindtouchstart="onVoiceTouchStart" bindtouchmove="onVoiceTouchMove" bindtouchend="onVoiceTouchEnd" bindtouchcancel="cancelVoice" disabled="{{loading}}">{{isRecording ? '松开结束' : '按住说话'}}</button>
        <button class="send-btn" loading="{{loading}}" bindtap="sendMessage" disabled="{{!inputText}}">发送回答</button>
        <button class="end-btn" loading="{{loading}}" bindtap="endChat">结束并评分</button>
      </view>
      <view wx:if="{{voiceStatus}}" class="voice-status">{{voiceStatus}}</view>
    </view>

    <view wx:if="{{voiceActive || voiceStarting}}" class="voice-overlay" catchtouchmove="onVoiceTouchMove">
      <view class="voice-sheet">
        <view class="voice-mic {{voiceCancelArmed ? 'voice-mic-cancel' : ''}}">{{voiceCancelArmed ? '取消' : '麦'}}</view>
        <view class="voice-overlay-title">{{voiceCancelArmed ? '松开取消' : '正在录音'}}</view>
        <view class="voice-duration">{{voiceDuration}}</view>
        <view class="voice-bars" wx:if="{{!voiceCancelArmed}}">
          <view wx:for="{{voiceBars}}" wx:key="*this" class="voice-bar voice-bar-{{index}}"></view>
        </view>
        <view class="voice-cancel-hint">{{voiceCancelArmed ? '松开手指取消本次录音' : '上滑取消'}}</view>
      </view>
    </view>

    <button wx:if="{{ended}}" class="btn-primary" bindtap="restart">再练一轮</button>
  </view>
</view>
